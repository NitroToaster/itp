<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="640" prefHeight="400" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2" fx:controller="gr2536.fxui.FridgeAppController">
    <children>
        <VBox spacing="8" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <HBox spacing="8">
                <TextField fx:id="itemInput" promptText="Enter item..." HBox.hgrow="ALWAYS"/>
                <Button fx:id="addButton" text="Add"/>
                <Button fx:id="removeButton" text="Remove"/>
                <Button fx:id="loadButton" text="Load"/>                
                <Button fx:id="saveButton" text="Save"/>
            </HBox>
            <ListView fx:id="fridgeList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </children>
</AnchorPane>