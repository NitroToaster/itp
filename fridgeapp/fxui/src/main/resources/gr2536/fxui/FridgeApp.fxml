<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="root" styleClass="app-root" prefWidth="1040" prefHeight="650" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gr2536.fxui.FridgeAppController">
  <children>
    <HBox spacing="18" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
      <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="220" minWidth="220" maxWidth="220">
        <padding><Insets top="18" right="16" bottom="18" left="16"/></padding>
        <spacing>14</spacing>
        <children>
          <HBox spacing="8" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
              <Label text="FridgeApp" styleClass="sidebar-title"/>
              <Label text="Kitchen command center" styleClass="sidebar-subtitle" wrapText="true"/>
            </VBox>
            <Button fx:id="toggleSidebarButton" text="‹" styleClass="sidebar-toggle-btn" onAction="#onToggleSidebar"/>
          </HBox>
          <Separator/>

          <VBox spacing="6" styleClass="sidebar-group">
            <Label text="Overview" styleClass="sidebar-heading"/>
            <Button fx:id="navFridgeButton" text="Fridge Overview" styleClass="sidebar-button" onAction="#onNavigateToFridge"/>
            <Button fx:id="shoppingListButton" text="Shopping List" styleClass="sidebar-button" onAction="#onNavigateToShoppingList"/>
          </VBox>

          <VBox spacing="6" styleClass="sidebar-group">
            <Label text="Data" styleClass="sidebar-heading"/>
            <Button text="Load Data" styleClass="sidebar-button" onAction="#onLoad"/>
          </VBox>

          <Region VBox.vgrow="ALWAYS"/>
          <Label text="Groceries made simple" styleClass="sidebar-footer" wrapText="true"/>
        </children>
      </VBox>

      <VBox spacing="12" styleClass="panel workspace" HBox.hgrow="ALWAYS">
        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

        <!-- Menu button (visible when sidebar is collapsed) -->
        <HBox spacing="8" styleClass="workspace-toolbar">
          <Button fx:id="showSidebarButton" text="☰" styleClass="menu-button" onAction="#onToggleSidebar" visible="false" managed="false"/>
        </HBox>

        <!-- Header Bar -->
        <VBox spacing="8" styleClass="header-bar">
          <!-- Row 1: Page Title and Search Controls -->
          <HBox spacing="10" alignment="CENTER_LEFT" styleClass="search-row">
            <Label text="Fridge" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS" minWidth="10"/>
            <TextField fx:id="searchField" promptText="Search items..." prefWidth="200" HBox.hgrow="ALWAYS">
              <tooltip><Tooltip text="Type to search your fridge"/></tooltip>
            </TextField>
            <ComboBox fx:id="searchModeCombo" promptText="Match" prefWidth="130">
              <tooltip><Tooltip text="How to match item names"/></tooltip>
            </ComboBox>
            <Button fx:id="searchButton" text="Search" styleClass="primary">
              <tooltip><Tooltip text="Click to search now"/></tooltip>
            </Button>
            <Button fx:id="clearSearchButton" text="Clear">
              <tooltip><Tooltip text="Clear search and show all"/></tooltip>
            </Button>
          </HBox>
          
          <!-- Row 2: Filter and Action Controls -->
          <HBox spacing="10" alignment="CENTER_LEFT" styleClass="actions-row">
            <Button fx:id="toggleFiltersButton" text="Filter" styleClass="secondary" onAction="#onToggleFilters">
              <tooltip><Tooltip text="Show or hide filter options"/></tooltip>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="applyFilterButton" text="Apply" styleClass="secondary">
              <tooltip><Tooltip text="Apply filters to the list"/></tooltip>
            </Button>
            <Button fx:id="clearFilterButton" text="Clear">
              <tooltip><Tooltip text="Clear all filters"/></tooltip>
            </Button>
            <Button fx:id="addButton" text="Add Item" styleClass="primary">
              <tooltip><Tooltip text="Add a new item"/></tooltip>
            </Button>
          </HBox>
        </VBox>

        <!-- Filter Section (hidden by default) -->
        <VBox fx:id="filtersPanel" spacing="6" styleClass="section" managed="false" visible="false">
          <Label text="Filters" styleClass="section-header"/>
          <GridPane hgap="8" vgap="6">
            <columnConstraints>
              <ColumnConstraints prefWidth="60" hgrow="NEVER"/>
              <ColumnConstraints prefWidth="95" hgrow="NEVER"/>
              <ColumnConstraints prefWidth="60" hgrow="NEVER"/>
              <ColumnConstraints prefWidth="95" hgrow="NEVER"/>
              <ColumnConstraints prefWidth="150" hgrow="ALWAYS"/>
              <ColumnConstraints prefWidth="150" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
              <RowConstraints vgrow="NEVER"/>
              <RowConstraints vgrow="NEVER"/>
            </rowConstraints>
            <children>
              <Label text="Qty Min:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
              <Spinner fx:id="filterMinQuantitySpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
              <Label text="Max:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
              <Spinner fx:id="filterMaxQuantitySpinner" editable="true" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
              <DatePicker fx:id="filterExpirationFromPicker" promptText="Expiration From" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
              <DatePicker fx:id="filterExpirationUntilPicker" promptText="Expiration Until" GridPane.columnIndex="5" GridPane.rowIndex="0"/>

              <CheckBox fx:id="filterIncludeUnknownCheck" text="Include items without expiration date" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="6"/>
            </children>
          </GridPane>
        </VBox>


        <!-- Fridge Items List -->
        <VBox spacing="6" VBox.vgrow="ALWAYS">
          <Label text="Fridge Items" styleClass="section-header"/>
          
          <!-- Column Headers with Sort Arrows -->
          <HBox spacing="10" styleClass="list-header">
            <Label fx:id="nameHeaderLabel" text="Name" styleClass="list-header-column" onMouseClicked="#onSortByName" HBox.hgrow="ALWAYS">
              <tooltip><Tooltip text="Click to sort by name"/></tooltip>
            </Label>
            <Label fx:id="quantityHeaderLabel" text="Quantity" styleClass="list-header-column" onMouseClicked="#onSortByQuantity" prefWidth="80">
              <tooltip><Tooltip text="Click to sort by quantity"/></tooltip>
            </Label>
            <Label fx:id="expirationHeaderLabel" text="Expiration" styleClass="list-header-column" onMouseClicked="#onSortByExpiration" prefWidth="120">
              <tooltip><Tooltip text="Click to sort by expiration date"/></tooltip>
            </Label>
            <Region prefWidth="150"/>
          </HBox>
          
          <ListView fx:id="fridgeList" VBox.vgrow="ALWAYS"/>
        </VBox>
      </VBox>
    </HBox>

  </children>
</AnchorPane>