<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="640" prefHeight="400" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2" fx:controller="gr2536.fxui.FridgeAppController">
    <children>
        <VBox spacing="8" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <GridPane hgap="8" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/> 
                    <ColumnConstraints percentWidth="25"/> 
                    <ColumnConstraints percentWidth="15"/> 
                    <ColumnConstraints percentWidth="35"/>
                </columnConstraints>
                <children>
                    <TextField fx:id="nameField" promptText="Name" GridPane.columnIndex="0"/>
                    <TextField fx:id="unitField" promptText="Unit" GridPane.columnIndex="1"/>
                    <Spinner fx:id="quantitySpinner" editable="false" GridPane.columnIndex="2"/>
                    <DatePicker fx:id="expirationPicker" promptText="YYYY-MM-DD" GridPane.columnIndex="3"/>
                </children>
            </GridPane>

            <HBox spacing="8">
                <Button fx:id="addButton" text="Add"/>
                <Button fx:id="removeButton" text="Remove"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="loadButton" text="Load"/>                
                <Button fx:id="saveButton" text="Save"/>
            </HBox>


            <ListView fx:id="fridgeList" VBox.vgrow="ALWAYS"/>
            
        </VBox>
    </children>
</AnchorPane>