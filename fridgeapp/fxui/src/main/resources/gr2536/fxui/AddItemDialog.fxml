<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane fx:id="dialogPane" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gr2536.fxui.AddItemDialogController" headerText="Add item to fridge">

    <content>
        <GridPane hgap="8" vgap="6">
            <padding><Insets top="6" right="6" bottom="6" left="6"/></padding>
            <columnConstraints>
                <ColumnConstraints prefWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Item Properties -->
            <children>
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" promptText="e.g. milk" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Quantity:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Spinner fx:id="quantitySpinner" editable="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Expiration:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="expirationPicker" promptText="YYYY-MM-DD" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </children>
        </GridPane>
    </content>

    <buttonTypes>
        <ButtonType text="Add" buttonData="OK_DONE"/>
        <ButtonType text="Cancel" buttonData="CANCEL_CLOSE"/>
    </buttonTypes>
</DialogPane>
    